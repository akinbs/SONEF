# Ana adres (sonunda / olmadan, yalnızca https kökü). Canonical, og:url, sitemap ve
# yapılandırılmış veri bu değerden üretilir. Eksik veya geçersizse bunlar üretilmez ve site noindex kalır.
NEXT_PUBLIC_SITE_URL=

# Yayın hedefi (lib/site.ts → indexingAllowed). YALNIZCA canlı yayın derlemesinde "production" verin.
# Boş veya başka bir değer: bütün sayfalar noindex, X-Robots-Tag başlığı eklenir, sitemap boş döner.
# Netlify'da ayrıca CONTEXT=production olmayan derlemeler (Deploy Preview, branch deploy) her durumda noindex kalır.
# Değer DERLEME sırasında okunur; değiştirdikten sonra yeniden derleyin.
SITE_ENV=
